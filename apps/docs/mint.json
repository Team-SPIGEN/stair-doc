{
  "$schema": "https://mintlify.com/schema.json",
  "name": "Stair-Doc",
  "favicon": "/logos/logo.svg",
  "logo": {
    "light": "/logos/logo.svg",
    "dark": "/logos/logo-light.svg"
  },
  "colors": {
    "primary": "#3b82f6",
    "light": "#93c5fd",
    "dark": "#1e3a8a",
    "background": {
      "dark": "#030712",
      "light": "#ffffff"
    }
  },
  "modeToggle": {
    "default": "dark"
  },
  "topbarCtaButton": {
    "name": "Dashboard",
    "url": "https://next-fast-turbo.vercel.app/"
  },
  "tabs": [
    {
      "name": "API Reference",
      "url": "api"
    }
  ],
  "anchors": [
    {
      "name": "Documentation",
      "icon": "book-open-cover",
      "url": "documentation"
    },
    {
      "name": "API Reference",
      "icon": "rectangle-terminal",
      "url": "api"
    }
  ],
  "navigation": [
    {
      "group": "Getting Started",
      "pages": [
        "documentation/introduction",
        "documentation/local-development"
      ]
    },
    {
      "group": "Configuration",
      "pages": [
        "documentation/configuration/turbo",
        "documentation/configuration/fastapi",
        "documentation/configuration/nextjs",
        "documentation/configuration/docs"
      ]
    },
    {
      "group": "Deployment",
      "pages": [
        "documentation/deployment/deployment"
      ]
    },
    {
      "group": "Authentication",
      "pages": [
        "api/auth/login",
        "api/auth/register",
        "api/auth/me"
      ]
    },
    {
      "group": "Robots",
      "pages": [
        "api/robots/get-status",
        "api/robots/get-telemetry"
      ]
    },
    {
      "group": "Deliveries",
      "pages": [
        "api/deliveries/get-all-deliveries",
        "api/deliveries/get-delivery",
        "api/deliveries/create-delivery",
        "api/deliveries/update-delivery",
        "api/deliveries/delete-delivery"
      ]
    },
    {
      "group": "RFID",
      "pages": [
        "api/rfid/scan",
        "api/rfid/get-tags",
        "api/rfid/assign-tag"
      ]
    }
  ],
  "api": {
    "maintainOrder": true,
    "baseUrl": "https://YOUR-RAILWAY-URL.railway.app"
  },
  "openapi": "https://YOUR-RAILWAY-URL.railway.app/openapi.json",
  "feedback": {
    "thumbsRating": true
  },
  "footerSocials": {
    "github": "https://github.com/cording12/next-fast-turbo"
  }
}