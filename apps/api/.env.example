DB_URL=supabase_url
DB_API_KEY=supabase_api_key
DB_EMAIL=email_address
DB_PASSWORD=password

# Set to production on the hosted API to enforce secret/origin checks.
ENVIRONMENT=development
ROOT_PATH=

# Auth
JWT_SECRET_KEY=change-me-to-a-random-secret-at-least-32-characters
DEMO_USER_PASSWORD=change-me-before-production

# Push Notifications (VAPID)
# Generate with: python3 generate_vapid.py
VAPID_PUBLIC_KEY=your_vapid_public_key_base64url
VAPID_PRIVATE_KEY=-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----
VAPID_MAILTO=mailto:admin@stairdoc.app

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Leave blank to reuse CORS_ORIGINS, or include the frontend origin plus the API origin
# used by the Raspberry Pi bridge Socket.IO client.
SOCKET_CORS_ORIGINS=

# Robot hardware bridge (Raspberry Pi ↔ ESP32)
ROBOT_BRIDGE_TOKEN=change-me-to-a-random-bridge-token
BRIDGE_STALE_SECONDS=15

# Local prototype database + uploaded image storage
STAIRDOC_DATA_DIR=./.stairdoc-data
