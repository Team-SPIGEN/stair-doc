# Stair-Doc Pi Bridge — copy to .env on the Raspberry Pi

# Backend URLs (first reachable one wins)
# Use the Mac/backend LAN IP for local testing, not the Raspberry Pi's IP.
# After production deploy, replace this with the hosted backend URL only.
STAIRDOC_API_URLS=http://172.20.10.8:8000,http://127.0.0.1:8000

# Optional single fixed URL override; normally leave commented when using URLS.
# STAIRDOC_API_URL=http://127.0.0.1:8000

# Must match apps/api/.env ROBOT_BRIDGE_TOKEN (leave empty for dev)
ROBOT_BRIDGE_TOKEN=

# Robot ID — must match the app (robot-001)
ROBOT_ID=robot-001

# ESP32 connection: serial (USB/UART) or bluetooth
ESP32_CONNECTION=serial
# Prefer a stable ESP32 symlink when LIDAR is also connected.
# Leave empty only when the ESP32 is the only USB serial device.
ESP32_SERIAL_PORT=/dev/sensors/esp32
ESP32_SERIAL_BAUD=115200
ESP32_SERIAL_EXCLUDE_PORTS=/dev/rplidar,/dev/sensors/rplidar

# Bluetooth option (after: sudo rfcomm bind 0 <ESP32_MAC> 1)
# ESP32_CONNECTION=bluetooth
# ESP32_BT_MAC=AA:BB:CC:DD:EE:FF
# ESP32_BT_PORT=/dev/rfcomm0

# Re-send movement commands before ESP32 10s timeout
COMMAND_REPEAT_SEC=3
TELEMETRY_INTERVAL_SEC=1.5
ESP32_RECONNECT_SEC=5
SOCKET_RECONNECT_SEC=5

PHOTO_DIR=/home/spigen/access_photos
LOCAL_AUTHORIZED_TAGS=432745742349,805223990738,1023250728362

# Local Raspberry Pi Vosk voice recognition
LOCAL_VOICE_ENABLED=false
LOCAL_VOICE_MODEL_PATH=/home/spigen/vosk_model/vosk-model-small-en-us-0.15
LOCAL_VOICE_SAMPLE_RATE=48000
LOCAL_VOICE_BLOCK_SIZE=8000
# Leave empty for default mic. If PortAudio reports device -1, set an input device index/name.
LOCAL_VOICE_DEVICE=
LOCAL_VOICE_ROLE=operator
LOCAL_VOICE_CONFIRM_ESTOP=true
LOCAL_VOICE_DIRECT_UNLOCK=true
LOCAL_VOICE_SPEAK_RESPONSE=false

# GPIO pins (BCM numbering)
SERVO_PIN=13
RED_LED=17
GREEN_LED=27
BUZZER=22

# ── ros2_bridge.py — SLAM / Nav2 relay ───────────────────────────────────
# Run this INSTEAD of bridge.py when the ROS 2 nav stack is active
# (after `bash ~/stairbot_firmware/start_nav.sh`).
#
#   source /opt/ros/humble/setup.bash
#   source ~/micro_ros_ws/install/setup.bash
#   python3 ~/stairbot_firmware/ros2_bridge.py
#
# "mapping"      = live SLAM Toolbox (robot explores and builds map)
# "localization" = Nav2 AMCL navigating on a pre-built saved map
SLAM_MODE=mapping

# Maximum occupied-cell points sent per slam_map event (reduce for slow Wi-Fi)
MAP_POINTS_MAX=2000

# Publish rates (Hz) — tune to reduce bandwidth on slow networks
SCAN_RATE_HZ=5
MAP_RATE_HZ=1

# Single URL override for ros2_bridge (set to your backend LAN IP):
# STAIRDOC_API_URL=http://192.168.1.100:8000
