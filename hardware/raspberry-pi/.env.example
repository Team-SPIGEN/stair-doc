# Stair-Doc Pi companion — copy to .env on the Raspberry Pi
#
# Manual joystick + Destination Nav2 both require:
#   micro_ros_agent on /dev/sensors/esp32  +  ros2_bridge.py
# UART ESP motor control is DISABLED in bridge.py (sensors-only only).

# Backend URLs (first reachable one wins)
STAIRDOC_API_URLS=http://172.20.10.8:8000,http://127.0.0.1:8000

# Optional single fixed URL override
# STAIRDOC_API_URL=http://127.0.0.1:8000

# Must match apps/api/.env ROBOT_BRIDGE_TOKEN (leave empty for dev)
ROBOT_BRIDGE_TOKEN=

# Robot ID — must match the app (robot-001)
ROBOT_ID=robot-001

# ESP32 UART motor bridge is removed. bridge.py always runs sensors-only.
ESP32_ENABLED=false
BRIDGE_MODE=sensors_only

# Legacy serial settings (unused for motors — micro_ros_agent owns the port)
ESP32_CONNECTION=serial
ESP32_SERIAL_PORT=/dev/sensors/esp32
ESP32_SERIAL_BAUD=115200
ESP32_SERIAL_EXCLUDE_PORTS=/dev/rplidar,/dev/sensors/rplidar

COMMAND_REPEAT_SEC=3
TELEMETRY_INTERVAL_SEC=1.5
ESP32_RECONNECT_SEC=5
SOCKET_RECONNECT_SEC=5

PHOTO_DIR=/home/spigen/access_photos
LOCAL_AUTHORIZED_TAGS=432745742349,805223990738,1023250728362

LOCAL_VOICE_ENABLED=false
LOCAL_VOICE_MODEL_PATH=/home/spigen/vosk_model/vosk-model-small-en-us-0.15
LOCAL_VOICE_SAMPLE_RATE=48000
LOCAL_VOICE_BLOCK_SIZE=8000
LOCAL_VOICE_DEVICE=
LOCAL_VOICE_ROLE=operator
LOCAL_VOICE_CONFIRM_ESTOP=true
LOCAL_VOICE_DIRECT_UNLOCK=true
LOCAL_VOICE_SPEAK_RESPONSE=false

# GPIO pins (BCM) — door unlock servo / LEDs (Pi, not ESP UART)
SERVO_PIN=13
RED_LED=17
GREEN_LED=27
BUZZER=22

# ── ros2_bridge.py — Manual /cmd_vel + Destination Nav2 ─────────────────
STAIRDOC_LOCATIONS_FILE=/home/spigen/maps/locations.json
SLAM_MODE=localization
MAP_POINTS_MAX=2000
SCAN_RATE_HZ=5
MAP_RATE_HZ=1
# STAIRDOC_API_URL=http://192.168.1.100:8000
